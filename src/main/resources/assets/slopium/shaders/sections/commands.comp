#version 430 core
layout(local_size_x=64) in;
layout(std430,binding=0) readonly buffer Visibility {uint visible[];};
struct Command {uint count;uint instances;uint first;uint base;uint instance;uint section;};
layout(std430,binding=2) buffer Commands {Command commands[];};
void main(){uint i=gl_GlobalInvocationID.x;if(i>=commands.length())return;uint id=commands[i].section;commands[i].instances=id>=visible.length()?1u:visible[id];}
