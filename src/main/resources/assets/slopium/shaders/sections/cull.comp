#version 430 core
layout(local_size_x=64) in;
layout(std430,binding=0) buffer Visibility { uint visible[]; };
struct Box {vec4 lo;vec4 hi;};
layout(std430,binding=1) readonly buffer Bounds {Box boxes[];};
layout(binding=0) uniform sampler2D pyramid;
uniform mat4 matrix;
uniform ivec2 viewport;
uniform int cameraCull;
uniform int levels;
uniform int baseShift;
void main(){uint id=gl_GlobalInvocationID.x;if(id>=boxes.length())return;
 Box b=boxes[id];if(b.hi.w==0.||b.lo.w!=0.){visible[id]=1u;return;} if(visible[id]!=0u)return;
 vec2 lo=vec2(1e30),hi=vec2(-1e30);float nearZ=1.;
 for(int i=0;i<8;i++){vec3 p=vec3((i&1)==0?b.lo.x:b.hi.x,(i&2)==0?b.lo.y:b.hi.y,(i&4)==0?b.lo.z:b.hi.z);vec4 v=matrix*vec4(p,1.);
 if(v.w<=0.||v.z<=-v.w){visible[id]=1u;return;}vec3 ndc=v.xyz/v.w;lo=min(lo,ndc.xy);hi=max(hi,ndc.xy);nearZ=min(nearZ,ndc.z*.5+.5);}
 if(any(lessThan(hi,vec2(-1)))||any(greaterThan(lo,vec2(1)))||nearZ>1.){visible[id]=cameraCull!=0?0u:1u;return;}
 // Expand screen bounds and bias the nearest depth toward the camera. Equality always stays visible.
 ivec2 a=clamp(ivec2(floor((lo*.5+.5)*viewport))-ivec2(2),ivec2(0),viewport-1);
 ivec2 z=clamp(ivec2(ceil((hi*.5+.5)*viewport))+ivec2(2),ivec2(0),viewport-1);
 a>>=baseShift;z>>=baseShift;
 int level=clamp(int(ceil(log2(float(max(z.x-a.x+1,z.y-a.y+1))/4.))),0,levels);
 a>>=level;z>>=level;float farZ=0.;for(int y=a.y;y<=z.y;y++)for(int x=a.x;x<=z.x;x++)farZ=max(farZ,texelFetch(pyramid,ivec2(x,y),level).r);
 visible[id]=nearZ<=farZ+0.00002?1u:0u;
}
